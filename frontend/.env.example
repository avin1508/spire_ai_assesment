# Copy to frontend/.env and fill in. EXPO_PUBLIC_* values are bundled into the
# app, so only put public identifiers here — never secrets.

# Google OAuth client IDs (Google Cloud Console → APIs & Services → Credentials).
# Android: package com.spireai.iexchange + your signing key's SHA-1.
# iOS: bundle id com.spireai.iexchange.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Map tiles (optional; defaults to the public OpenStreetMap server, dev use only).
# EXPO_PUBLIC_MAP_TILE_URL=
# EXPO_PUBLIC_MAP_ATTRIBUTION=

# Backend API (optional). Default: port 5000 on the computer running the Expo
# dev server (its LAN address, which a phone on the same Wi-Fi can reach;
# 10.0.2.2 on the Android emulator). Set it for tunnel mode or a remote backend,
# e.g. http://192.168.1.20:5000.
# EXPO_PUBLIC_API_URL=

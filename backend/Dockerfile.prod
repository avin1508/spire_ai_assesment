# Production image for the backend API (used by docker-compose.prod.yml).
# Secrets are not baked in: .env is excluded by .dockerignore and passed at
# runtime.

# --- Stage 1: install production dependencies only ---------------------------
FROM node:22.21.1-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

# --- Stage 2: runtime image (no npm cache, no dev dependencies, non-root) ----
FROM node:22.21.1-alpine
WORKDIR /app
ENV NODE_ENV=production

COPY --from=deps --chown=node:node /app/node_modules ./node_modules
COPY --chown=node:node package.json ./
COPY --chown=node:node src ./src

USER node
EXPOSE 5000

# Lets Docker (with or without Compose) report the container as unhealthy.
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD node -e "fetch('http://localhost:' + (process.env.PORT || 5000) + '/health').then((r) => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

CMD ["node", "src/server.js"]

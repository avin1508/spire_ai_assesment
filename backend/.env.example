PORT=5000

# MongoDB Atlas — copy to backend/.env and fill in. Never commit real values.
DB_USERNAME=your_atlas_username
DB_PASSWORD=your_atlas_password
DB_CLUSTER_URL=your-cluster.xxxxx.mongodb.net
DB_NAME=spire_db

# Redis (optional). Leave empty to run without Redis.
# Docker Compose sets this to redis://redis:6379 for the backend container.
# For `npm run dev` on the host, start Redis with `docker compose up -d redis`
# and use redis://localhost:6379.
REDIS_URL=redis://redis:6379

# Production Compose only (docker-compose.prod.yml): password for the Redis
# container. Use letters and digits only, e.g. the output of `openssl rand -hex 32`.
REDIS_PASSWORD=

# Gemini (resume parsing; read by the worker only — never sent to the app).
# Key from Google AI Studio. Model: a current stable model id from
# https://ai.google.dev/gemini-api/docs/models (e.g. gemini-3.5-flash-lite).
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# Gemini quota guard (worker). Optional — set from the limits shown in Google
# AI Studio for your project and model; unset values are not enforced locally
# (real 429 responses still pause all workers and defer recommendations).
# GEMINI_RPM=
# GEMINI_TPM=
# GEMINI_DAILY_BUDGET=
# Recommendation worker concurrency (default 1) and how long a finished
# result for an unchanged profile is reused (hours, default 24).
# RECOMMENDATION_CONCURRENCY=1
# RECOMMENDATION_FRESH_HOURS=24

# Accounts. Optional: sign-in sessions last SESSION_TTL_DAYS (default 30);
# password hashing cost BCRYPT_ROUNDS (default 12; don't lower it in production).
# SESSION_TTL_DAYS=30
# BCRYPT_ROUNDS=12

# Push notifications (worker): no variables needed. The worker uses the one
# Firebase service-account key file named *-firebase-adminsdk-*.json in
# backend/ (or the project root); the Firebase project id is read from it.
# Get it from Firebase Console → Project settings → Service accounts →
# Generate new private key. Never commit it (.gitignore) — Docker mounts it
# read-only into the worker (docker-compose*.yml). No key file = no pushes.

PORT=5000

# MongoDB Atlas — copy to backend/.env and fill in. Never commit real values.
DB_USERNAME=your_atlas_username
DB_PASSWORD=your_atlas_password
DB_CLUSTER_URL=your-cluster.xxxxx.mongodb.net
DB_NAME=spire_db

# Redis (optional). Leave empty to run without Redis.
# Docker Compose sets this to redis://redis:6379 for the backend container.
# For `npm run dev` on the host, start Redis with `docker compose up -d redis`
# and use redis://localhost:6379.
REDIS_URL=

# Production Compose only (docker-compose.prod.yml): password for the Redis
# container. Use letters and digits only, e.g. the output of `openssl rand -hex 32`.
REDIS_PASSWORD=
